<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/loader_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:layout_above="@id/footer_container">

        <LinearLayout
            android:id="@+id/loginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <!-- App Logo Icon Frame (Corner Rounded, AMOLED Surface) -->
            <androidx.cardview.widget.CardView
                android:layout_width="88dp"
                android:layout_height="88dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_dark"
                app:strokeWidth="1dp"
                app:strokeColor="@color/card_stroke">
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_launcher"
                    android:scaleType="fitCenter"
                    android:contentDescription="Application logo" />
            </androidx.cardview.widget.CardView>

            <!-- Brand Heading -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANOY LOADER"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="@color/text_primary"
                android:layout_marginTop="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure Client Authentication"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp" />

            <!-- Login Card Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/loader_card"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LICENSE KEY"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONLINE"
                        android:textColor="@color/success"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/loader_pill"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />
                </LinearLayout>

                <!-- Input Box with Show/Hide & Paste Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="18dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/loader_input">

                    <EditText
                        android:id="@+id/userkey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:background="@android:color/transparent"
                        android:singleLine="true"
                        android:inputType="text" />

                    <!-- Show / Hide Password Toggle -->
                    <ImageView
                        android:id="@+id/btnToggleVisibility"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_visibility"
                        android:tint="@color/text_secondary"
                        android:padding="8dp"
                        android:contentDescription="Show/Hide key"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <!-- Paste Button -->
                    <ImageView
                        android:id="@+id/paste"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_content_paste"
                        android:tint="@color/secondary"
                        android:padding="8dp"
                        android:contentDescription="Paste license key"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <!-- Save Key Checkbox Row -->
                <LinearLayout
                    android:id="@+id/llSaveKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/cbSaveKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:button="@drawable/checkbox_custom"
                        android:checked="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save License Key on this device"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Authenticate Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/login"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="AUTHENTICATE"
                    android:textAllCaps="true"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="@color/white"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/loader_button" />
            </LinearLayout>

            <TextView
                android:id="@+id/GetKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GET LICENSE KEY"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textColor="@color/secondary"
                android:padding="10dp"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </ScrollView>

    <!-- Footer Area -->
    <LinearLayout
        android:id="@+id/footer_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/app_name_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© 2026 ANOY LOADER • Enterprise Edition"
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</RelativeLayout>
