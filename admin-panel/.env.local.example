# =============================================================================
# Admin Panel — environment variables
# Copy to .env.local for local dev, or set the same keys in:
#   Vercel → Project → Settings → Environment Variables
# Never commit real secrets. Values below are placeholders only.
# =============================================================================

# --- Supabase (required for live DB) ---
# Public URL + anon key are safe for the browser (RLS still applies).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key is SERVER-ONLY. Used by API routes for privileged writes.
# Do NOT prefix with NEXT_PUBLIC_ — it must never ship to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Enable email/password signup + email confirmation in Supabase Auth.
# Configure Site URL and Redirect URLs for /dashboard on deployed hosts.
# Run ../supabase/migration_account_auth.sql, then approve your first account.
# ADMIN_PIN and ADMIN_SESSION_SECRET are no longer used.
