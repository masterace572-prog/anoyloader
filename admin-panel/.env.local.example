# =============================================================================
# Admin Panel — environment variables
# Copy to .env.local for local dev, or set the same keys in:
#   Vercel → Project → Settings → Environment Variables
# Never commit real secrets. Values below are placeholders only.
# =============================================================================

# --- Supabase (required for live DB) ---
# Public URL + anon key are safe for the browser (RLS still applies).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key is SERVER-ONLY. Used by API routes for privileged writes.
# Do NOT prefix with NEXT_PUBLIC_ — it must never ship to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Admin dashboard access (SERVER-ONLY) ---
# PIN checked only on the server via POST /api/admin/auth.
# There is NO default PIN in production code — you must set this.
ADMIN_PIN=change-me-to-a-strong-pin

# Optional: separate HMAC secret for session tokens.
# If omitted, a derivative of ADMIN_PIN is used.
# ADMIN_SESSION_SECRET=long-random-string-at-least-32-chars
